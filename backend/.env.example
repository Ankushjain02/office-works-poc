# Copy to backend/.env to override the defaults. The app runs without this file.
# Defaults: live Fake Store with a snapshot fallback, and enquiry emails written to data/outbox.

PORT=3000
PRODUCT_SOURCE=fake-store
PRODUCT_SOURCE_URL=https://fakestoreapi.com
SNAPSHOT_PATH=data/products.snapshot.json
FEATURED_PRODUCTS_FILE=config/featured-products.json
FEATURED_PRODUCT_IDS=1,5,9,15,11
CACHE_TTL_MS=60000

SALES_INBOX=sales@example.com
EMAIL_FROM=Catalogue <catalogue@localhost>
EMAIL_TRANSPORT=file
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
OUTBOX_DIR=data/outbox

ENQUIRY_RATE_LIMIT=10
ENQUIRY_RATE_WINDOW_MS=900000
