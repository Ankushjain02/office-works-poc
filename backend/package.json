{
  "name": "officeworks-catalogue-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Local catalogue API for the OfficeWorks proof of concept.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "nodemailer": "^6.10.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
